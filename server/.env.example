# ==========================================
# AtoAI Backend Server Environment Variables
# ==========================================

# Database Connection (PostgreSQL with pgvector extension)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atoai"

# Better Auth & Application URLs
BASE_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="atoai_secret_key_super_secure_better_auth_123456789"
ADMIN_URL="http://localhost:3001"

# Initial Admin Seeding (optional overrides for pnpm run seed)
INITIAL_ADMIN_EMAIL="admin@atoai.com"
INITIAL_ADMIN_PASSWORD="YourSecurePassword123!"
INITIAL_ADMIN_NAME="Master Admin"

# AI Embedding Provider ("ollama" | "jina" | "gemini")
EMBEDDING_PROVIDER="ollama"
EMBEDDING_DIMENSIONS=768

# Telegram Bot & Webhook Secrets
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
WEBHOOK_SECRET="your_webhook_secret_here"
TELEGRAM_CHANNEL_ID="-1001234567890"
TELEGRAM_WEBHOOK_URL="https://your-domain.com/api/telegram/webhook"

# Ollama AI Configuration (Local / Cloud)
LOCAL_OLLAMA_HOST="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="embeddinggemma"
OLLAMA_API_KEY="your_ollama_cloud_api_key_here"
CLOUD_OLLAMA_MODEL="gpt-oss:120b"

# Google Gemini AI Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Jina AI Embeddings Configuration
JINA_API_KEY="your_jina_api_key_here"
JINA_EMBEDDING_MODEL="jina-embeddings-v4"
